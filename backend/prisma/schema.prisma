generator client {
    provider = "prisma-client"
    output = "../generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    admin
    moderator
    user
}

model User {
    id               Int                @id @default(autoincrement())
    phone            String             @unique
    email            String?

    name             String?
    lastName         String?
    
    role             UserRole           @default(user)

    orders           Order[]

    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt
}

enum OrderStatus {
    pending
    paid
    // Бесплатный заказ (пробник): оплаты нет, отправление создано в Ozon Доставке
    confirmed
    cancelled
}

model Order {
    id               Int                @id @default(autoincrement())
    userId           Int
    user             User               @relation(fields: [userId], references: [id])

    status           OrderStatus        @default(pending)

    // extId — идентификатор заказа на стороне магазина (уникален для Ozon),
    // ozonOrderId — идентификатор заказа на стороне эквайринга
    extId            String             @unique @default(uuid())
    ozonOrderId      String?            @unique
    paymentUrl       String?
    paidAt           DateTime?

    // Пробник можно купить один раз на аккаунт: пока в заказе есть пробник и он не
    // отменён, здесь лежит id покупателя, а уникальность не даёт оформить второй.
    // При отмене заказа значение сбрасывается.
    probeUserId      Int?               @unique

    itemsTotal       Int
    deliveryPrice    Int
    total            Int

    // Адрес и получателя выбирает покупатель на странице оплаты Ozon.
    // У бесплатного заказа с пробником адрес — пункт выдачи Ozon, который выбрали на сайте.
    recipientName    String?
    city             String?
    address          String?
    postalCode       String?
    comment          String?

    // Пункт выдачи Ozon Доставки и номер заказа в ней (только для заказа с пробником)
    deliveryPointId  Int?
    ozonDeliveryNumber String?          @unique

    items            OrderItem[]

    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt
}

model OrderItem {
    id               Int                @id @default(autoincrement())
    orderId          Int
    order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

    productId        String
    productName      String
    price            Int
    quantity         Int

    // Артикул Ozon, если позиция — пробник (остаток списан в таблице)
    probeOfferId     String?
}

// Справочник пунктов выдачи Ozon Доставки: API отдаёт его только целиком,
// поиск по адресу для покупателя делаем по этой копии
model DeliveryPoint {
    id               Int                @id
    name             String
    address          String
    type             String?
    latitude         Float?
    longitude        Float?
    isActive         Boolean
    shipmentMethodIds Int[]

    syncedAt         DateTime
}
